{
  "name": "terminal-signal-repository",
  "version": "0.0.0",
  "description": "A local-first attention layer for coding-agent CLIs.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:standalone": "node scripts/release/build-standalone.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:integration && npm run test:distribution && npm run test:site && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:coverage": "node --experimental-test-coverage '--test-coverage-include=src/core/**/*.ts' --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=95 --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:site": "node --test tests/site/*.test.ts",
    "test:distribution": "node --test tests/distribution/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern packages/cli/dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern work --ignore-pattern outputs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "postject": "1.0.0-alpha.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
