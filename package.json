{
  "name": "side-glance-repository",
  "version": "0.0.0",
  "description": "A local-first attention layer for coding-agent CLIs.",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:standalone": "node scripts/release/build-standalone.mjs",
    "assets:upload:r2": "node scripts/assets/upload-r2.mjs",
    "start": "next start",
    "test": "npm run test:unit && npm run test:integration && npm run test:distribution && npm run test:site && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:coverage": "node --experimental-test-coverage '--test-coverage-include=src/core/**/*.ts' --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=95 --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:site": "node --test tests/site/*.test.ts",
    "test:distribution": "node --test tests/distribution/*.test.mjs",
    "lint": "npm run lint:site && npm run lint:repo",
    "lint:site": "biome check .",
    "lint:site:fix": "biome check --write .",
    "lint:repo": "eslint . --ignore-pattern dist --ignore-pattern packages/cli/dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern work --ignore-pattern outputs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "motion": "13.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "agentation": "3.0.2",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "ultracite": "7.0.12"
  },
  "type": "module"
}
