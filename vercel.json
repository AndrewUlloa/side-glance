{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "routes": [
    {
      "src": "/(.*)",
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": {
            "key": "vary"
          },
          "args": ["Accept", "Accept-Encoding"]
        }
      ]
    }
  ]
}
